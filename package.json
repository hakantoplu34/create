{
  "name": "ilham",
  "productName": "İlham",
  "version": "0.1.0",
  "description": "Kısayol reklam ilham arşivi: hesaplara giriş, arşive kaydet, Google Drive depolama, masonry arşiv ve panolar.",
  "main": "src/main.js",
  "author": "Kısayol",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.kisayol.ilham",
    "productName": "İlham",
    "artifactName": "Ilham-${version}-${arch}.${ext}",
    "files": ["src/**/*", "package.json"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [{ "from": "bin/${arch}", "to": "bin", "filter": ["**/*"] }]
    },
    "dmg": {
      "title": "İlham",
      "contents": [
        { "x": 140, "y": 180 },
        { "x": 400, "y": 180, "type": "link", "path": "/Applications" }
      ]
    },
    "win": { "target": ["nsis"] }
  }
}
